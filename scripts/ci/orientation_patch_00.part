        "    namespace product_presentation\n    {\n"
        "        using OrientedRasterDecorator = std::function<void(\n"
        "            image::Image &,\n"
        "            const image::presentation::OrientationInfo &)>;\n\n"
        "        struct OutputSettings",
        f"{path} decorator alias",
