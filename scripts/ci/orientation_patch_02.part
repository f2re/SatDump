                    point.first, point.second, map_width, map_height, transform);
            };
        }

        product_presentation::OrientedRasterDecorator make_geographic_context_decorator(
            const nlohmann::json &settings,
            const ProjectionFunction &projection,
            bool force_context)
        {
            if (!projection)
                return {};

            return [settings, projection, force_context](
                       image::Image &oriented,
                       const image::presentation::OrientationInfo &orientation)
            {
                OverlayHandler handler;
                handler.set_config(settings);
                if (force_context)
                    enable_presentation_geographic_context(
                        handler, settings, oriented.width());
                if (!handler.enabled())
                    return;

                ensure_rgb_preserving_projection(oriented);
                handler.apply(
                    oriented,
                    transform_projection_for_orientation(
                        projection, orientation.transform));
            };
        }
    }

